# AETHERIS M01–M10 Environment Configuration
# Copy to .env and adjust as needed.

# Auth
AETHERIS_API_KEY=
AETHERIS_JWT_SECRET=aetheris-hackathon-secret-key
AETHERIS_AUTH_ENABLED=true

# Rate Limiting
AETHERIS_RATE_LIMIT_RPM=60
AETHERIS_MAX_CONCURRENT_JOBS=4

# Upload
AETHERIS_MAX_UPLOAD_MB=50

# Session
AETHERIS_SESSION_TTL=3600
AETHERIS_MAX_CACHE=512

# Ollama
AETHERIS_OLLAMA_URL=http://localhost:11434
AETHERIS_NO_LLM=1

# JEV Engine (Judgement-Evaluation-Verification)
# Fast, typed, probabilistic decision engine for routing, scoring, and
# verification. Replaces LLM-based planning with zero-token, <1ms decisions.
# When both JEV and LLM are enabled, JEV routes while LLM synthesises —
# saving ~1200 tokens per query.
AETHERIS_USE_JEV=true

# GUI
AETHERIS_GUI_HOST=0.0.0.0
AETHERIS_GUI_PORT=5000
AETHERIS_GUI_DEBUG=false

# CORS
AETHERIS_CORS_ORIGINS=http://localhost:3000,http://localhost:5000
